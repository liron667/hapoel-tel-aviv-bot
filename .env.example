# Copy to .env and fill in. Never commit the real .env.
#
# 1. BOT_TOKEN: open @BotFather in Telegram -> /newbot -> copy the token.
#    Add that bot as an ADMIN of your Arsenal channel (Post Messages enabled).
# 2. TARGET_CHANNEL_ID: your Arsenal channel id (e.g. -100xxxxxxxxxx).
#
# Test:  python bot.py --dry-run    (prints matches, posts nothing)
# Post:  python bot.py

BOT_TOKEN=
TARGET_CHANNEL_ID=

# Free key from https://aistudio.google.com/app/apikey (for AI-written posts)
GEMINI_API_KEY=
